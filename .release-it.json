{
  "git": {
    "changelog": null,
    "commit": true,
    "commitMessage": ":bookmark: Release ${version}",
    "commitArgs": [],
    "tag": true,
    "tagName": null,
    "tagMatch": null,
    "tagAnnotation": "Release ${version}",
    "pushArgs": [],
    "releaseNotes": null
  },
  "github": {
    "release": false,
    "releaseName": "Release ${version}",
    "preRelease": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        "octopus-image-optimizer.php"
      ]
    }
  },
  "hooks": {
    "before:init": ["bash tools/check-ci.sh", "bash tools/check-translations.sh"],
    "after:release": "git push origin ${version}",
    "after:bump": [
      "perl -pi -e 's/^Stable tag:.*/Stable tag: ${version}/; s/^= Unreleased =$/= ${version} =/' readme.txt",
      "perl -pi -e \"s/^## Unreleased\\$/## ${version} – $(date +%F)/\" CHANGELOG.md",
      "perl -pi -e '/project-id-version/i and s/(?<=Octopus Image Optimizer )\\d[\\w.+-]*/${version}/' languages/*.pot languages/*.po",
      "wp i18n make-mo languages --quiet && wp i18n make-php languages --quiet"
    ]
  }
}
