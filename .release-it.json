{
  "git": {
    "changelog": null,
    "commit": true,
    "commitMessage": ":bookmark: Release ${version}",
    "commitArgs": [],
    "tag": true,
    "tagName": null,
    "tagMatch": null,
    "tagAnnotation": "${version}",
    "requireBranch": ["dev", "hotfix/*"],
    "pushArgs": [],
    "releaseNotes": null
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        "octopus-image-optimizer.php"
      ]
    }
  },
  "hooks": {
    "before:init": [
      "bash tools/release/check-ci.sh",
      "bash tools/release/check-notes.sh",
      "bash tools/release/check-wordpress.sh",
      "bash tools/check-translations.sh"
    ],
    "after:bump": "bash tools/release/bump.sh ${version}",
    "after:release": [
      "git push origin ${version}",
      "git push origin HEAD:main",
      "bash tools/release/open-notes.sh"
    ]
  }
}
