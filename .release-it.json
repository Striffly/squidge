{
  "git": {
    "changelog": null,
    "commit": true,
    "commitMessage": "Release ${version}",
    "commitArgs": [],
    "tag": true,
    "tagName": null,
    "tagMatch": null,
    "tagAnnotation": "Release ${version}",
    "releaseNotes": null
  },
  "github": {
    "release": false,
    "releaseName": "Release ${version}",
    "preRelease": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        "octopus-image-optimizer.php"
      ]
    }
  },
  "hooks": {
    "after:bump": "perl -pi -e 's/^Stable tag:.*/Stable tag: ${version}/' readme.txt"
  }
}
