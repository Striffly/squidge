{
    "name": "striffly/octopus-image-optimizer",
    "description": "OIO – Octopus Image Optimizer: compresses JPG and PNG images and converts them to WebP and AVIF on your own server.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Clément Gayot",
            "homepage": "https://github.com/Striffly"
        }
    ],
    "require": {
        "php": ">=8.2",
        "deliciousbrains/wp-background-processing": "^1.4"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Octopus\\Vendor\\",
            "classmap_prefix": "Octopus_Vendor_",
            "packages": [
                "deliciousbrains/wp-background-processing"
            ],
            "delete_vendor_packages": true
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "strauss",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ],
        "test": "phpunit",
        "test:multisite": [
            "@putenv WP_MULTISITE=1",
            "phpunit"
        ],
        "lint": "phpcs",
        "make-pot": "wp i18n make-pot . languages/octopus-image-optimizer.pot --exclude=vendor-prefixed,tests,node_modules,vendor",
        "translations": [
            "@make-pot",
            "wp i18n update-po languages/octopus-image-optimizer.pot",
            "wp i18n make-mo languages",
            "wp i18n make-php languages",
            "wp i18n make-json languages --no-purge"
        ]
    },
    "require-dev": {
        "brianhenryie/strauss": "^0.31.1",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0",
        "wp-phpunit/wp-phpunit": "^7.1",
        "roots/wordpress-no-content": "^7.1",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
