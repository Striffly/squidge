#. Plugin Name of the plugin
#: octopus-image-optimizer.php
msgid "OIO – Octopus Image Optimizer"
msgstr "OIO – Octopus Image Optimizer"

#. Plugin URI of the plugin
#: octopus-image-optimizer.php
msgid "https://github.com/Striffly/octopus-image-optimizer"
msgstr "https://github.com/Striffly/octopus-image-optimizer"

#. Description of the plugin
#: octopus-image-optimizer.php
msgid "Compresses JPG and PNG images and converts them to WebP and AVIF on your own server, with cwebp, avifenc, jpegoptim and optipng. Free, unlimited, no API key."
msgstr "Compresse les images JPG et PNG et les convertit en WebP et AVIF sur votre propre serveur, avec cwebp, avifenc, jpegoptim et optipng. Gratuit, illimité, sans clé d’API."

#. Author of the plugin
#: octopus-image-optimizer.php
msgid "Clément Gayot"
msgstr "Clément Gayot"

#. Author URI of the plugin
#: octopus-image-optimizer.php
msgid "https://github.com/Striffly"
msgstr "https://github.com/Striffly"

