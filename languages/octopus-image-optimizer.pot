msgid "Maximum image size"
msgstr ""

#. translators: 1: the minimum, 2: the maximum, 3: the default.
#: core/Admin/Fields.php:179
#, php-format
msgid "WordPress scales the bigger images down on upload, and keeps them as their original. Longest side, %3$d by default. <strong>0 means no limit: huge images can exhaust the server.</strong>"
msgstr ""

#: core/Admin/Fields.php:184
msgid "Serve"
msgstr ""

#: core/Admin/Fields.php:185
msgid "Each browser gets the lightest version it reads: AVIF, then WebP, or the JPG or PNG for older ones. Choose one way, or both."
msgstr ""

#: core/Admin/Fields.php:189
msgid "In the HTML, with <picture>"
msgstr ""

#: core/Admin/Fields.php:190
msgid "Wraps the images of the content in a <code>&lt;picture&gt;</code>. Untick it if the layout breaks."
msgstr ""

#: core/Admin/Fields.php:191
msgid "Images of the post content, featured images and galleries are wrapped in a <code>&lt;picture&gt;</code> tag offering the AVIF and WebP versions. Works on every server. <strong>Untick this if your theme layout breaks around images.</strong>"
msgstr ""

#: core/Admin/Fields.php:195
msgid "From the server, with rewrite rules"
msgstr ""

#: core/Admin/Fields.php:196
msgid "Every image, CSS backgrounds included, the HTML unchanged."
msgstr ""

#: core/Admin/Fields.php:197
msgid "The server answers <code>photo.jpg</code> with <code>photo.jpg.avif</code> or <code>.webp</code> when the browser reads them. The HTML does not change, and every image is served, CSS backgrounds and custom themes included. A CDN must vary its cache on the <code>Accept</code> header."
msgstr ""

