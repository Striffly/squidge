#: core/Admin/Fields.php:86
#: core/Admin/Fields.php:138
#, php-format
msgid "From %1$d to %2$d, %3$d by default."
msgstr ""

#: core/Admin/Fields.php:92
msgid "lossy compression"
msgstr ""

#: core/Admin/Fields.php:93
msgid "optipng compresses the PNG images for now. Once installed, oxipng replaces it on its own: the files are lighter at the same level, and it is a little faster."
msgstr ""

#: core/Admin/Fields.php:97
msgid "Compress PNG images"
msgstr ""

#: core/Admin/Fields.php:98
msgid "Compresses the PNG images in place with oxipng or optipng, after pngquant when lossy. Their originals are kept."
msgstr ""

#: core/Admin/Fields.php:102
msgid "Compression"
msgstr ""

#: core/Admin/Fields.php:104
msgid "Lossless"
msgstr ""

#: core/Admin/Fields.php:105
msgid "Lossy (pngquant)"
msgstr ""

#: core/Admin/Fields.php:107
msgid "Lossy: often 60 to 80 % lighter, for graphics and screenshots. Needs pngquant."
msgstr ""

#: core/Admin/Fields.php:111
msgid "Optimisation level"
msgstr ""

#. translators: 1: the minimum, 2: the maximum, 3: the default.
#: core/Admin/Fields.php:114
#, php-format
msgid "From o%1$d (fastest) to o%2$d (smallest files), o%3$d by default."
msgstr ""

#: core/Admin/Fields.php:118
msgid "Lossy quality"
msgstr ""

#. translators: 1: the minimum, 2: the maximum, 3: the default.
#: core/Admin/Fields.php:121
#, php-format
msgid "The quality pngquant aims at, %3$d by default."
msgstr ""

#. translators: %s: GD or Imagick.
#: core/Admin/Fields.php:127
#, php-format
msgid "%s makes the WebP files for now, in the PHP process. cwebp runs apart from PHP, and makes the PNG graphics and screenshots much lighter."
msgstr ""

#: core/Admin/Fields.php:131
msgid "Make WebP versions"
msgstr ""

#: core/Admin/Fields.php:132
msgid "Makes a WebP version of each image and thumbnail (<code>photo.jpg.webp</code>), lighter than the JPG or PNG."
msgstr ""

#. translators: %s: GD or Imagick.
#: core/Admin/Fields.php:144
#, php-format
msgid "%s makes the AVIF files for now, in the PHP process. avifenc runs apart from PHP, on several threads, and keeps the colours of the PNG images sharper."
msgstr ""

#: core/Admin/Fields.php:148
msgid "Make AVIF versions"
msgstr ""

#: core/Admin/Fields.php:149
msgid "Makes an AVIF version of each image and thumbnail (<code>photo.jpg.avif</code>), often the lightest. Kept only when lighter than the WebP and the JPG or PNG."
msgstr ""

#. translators: 1: the minimum, 2: the maximum, 3: the default.
#: core/Admin/Fields.php:155
#, php-format
msgid "From %1$d to %2$d (lossless), %3$d by default."
msgstr ""

