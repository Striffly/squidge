msgstr ""

#. Description of the plugin
#: octopus-image-optimizer.php
msgid "Compresses JPG and PNG images and converts them to WebP and AVIF on your own server, with cwebp, avifenc, jpegoptim and optipng. Free, unlimited, no API key."
msgstr ""

#. Author of the plugin
#: octopus-image-optimizer.php
msgid "Clément Gayot"
msgstr ""

#. Author URI of the plugin
#: octopus-image-optimizer.php
msgid "https://github.com/Striffly"
msgstr ""

#: core/Admin/Fields.php:79
msgid "Compress JPG images"
msgstr ""

#: core/Admin/Fields.php:80
msgid "Compresses the JPG images in place with jpegoptim, and makes them progressive. Their originals are kept."
msgstr ""

#: core/Admin/Fields.php:84
#: core/Admin/Fields.php:136
#: core/Admin/Fields.php:153
msgid "Quality"
msgstr ""

