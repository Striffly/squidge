{
  "name": "octopus-image-optimizer",
  "version": "0.1.4",
  "private": true,
  "description": "OIO – Octopus Image Optimizer: compresses JPG and PNG images and converts them to WebP and AVIF on your own server.",
  "author": "Clément Gayot",
  "license": "GPL-3.0-or-later",
  "files": [
    "octopus-image-optimizer.php",
    "uninstall.php",
    "autoload.php",
    "core",
    "functions",
    "templates",
    "languages",
    "assets/css",
    "assets/js",
    "assets/fonts",
    "assets/images/icon-128x128.png",
    "assets/images/icon-128x128.gif",
    "assets/images/icon-256x256.png",
    "assets/images/icon-256x256.gif",
    "assets/images/bitcoin-qr.svg",
    "vendor-prefixed",
    "!vendor-prefixed/**/tests",
    "!vendor-prefixed/**/bin",
    "!vendor-prefixed/**/.*",
    "!vendor-prefixed/**/Makefile",
    "!vendor-prefixed/**/phpunit.xml*",
    "!vendor-prefixed/**/composer.*",
    "readme.txt",
    "LICENSE"
  ],
  "scripts": {
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:zip": "composer install --no-interaction && bun run check-licenses && bun run plugin-zip",
    "check-translations": "bash tools/check-translations.sh",
    "lint": "bun run lint:php && bun run lint:js && bun run lint:css",
    "lint:php": "composer lint",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "fix": "eslint . --fix && stylelint \"assets/css/**/*.css\" --fix",
    "check-licenses": "wp-scripts check-licenses --prod",
    "plugin-zip": "wp-scripts plugin-zip && zip -dq octopus-image-optimizer.zip octopus-image-optimizer/README.md octopus-image-optimizer/package.json",
    "brand": "bun tools/brand/build.js",
    "prepare": "node -e \"process.env.CI || !require('fs').existsSync('.git') || require('child_process').execSync('lefthook install', {stdio:'inherit'})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.13",
    "@release-it/bumper": "^8.0.1",
    "@wordpress/scripts": "^37.0.0",
    "eslint": "^10.13.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "release-it": "^21.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
