<?xml version="1.0"?>
<!--
	The checks of the WordPress Coding Standards that matter for a plugin of
	WordPress.org, without their formatting rules: security (escaping, nonces,
	sanitised input, prepared SQL), translation, prefixes, the functions
	Plugin Check flags, and the PHP versions OIO supports. Run with
	composer lint.
-->
<ruleset name="OIO">
	<file>octopus-image-optimizer.php</file>
	<file>uninstall.php</file>
	<file>autoload.php</file>
	<file>core</file>
	<file>functions</file>
	<file>templates</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.DB.SlowDBQuery"/>
	<rule ref="WordPress.DB.DirectDatabaseQuery"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="octopus-image-optimizer"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DiscouragedFunctions"/>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<!-- As Plugin Check: on local files. -->
		<exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<!-- As Plugin Check, which forbids these. -->
	<rule ref="Generic.PHP.ForbiddenFunctions">
		<properties>
			<property name="forbiddenFunctions" type="array">
				<element key="eval" value="null"/>
				<element key="create_function" value="null"/>
				<element key="passthru" value="null"/>
				<element key="proc_open" value="null"/>
				<element key="move_uploaded_file" value="null"/>
				<element key="str_rot13" value="null"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="octopus"/>
				<element value="Octopus"/>
			</property>
		</properties>
	</rule>
</ruleset>
