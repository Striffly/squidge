<?xml version="1.0"?>
<!--
	The checks of the WordPress Coding Standards that matter for a plugin of
	WordPress.org, without their formatting rules: security (escaping, nonces,
	sanitised input, prepared SQL), translation, prefixes, and the PHP
	versions OIO supports. Run with composer lint.
-->
<ruleset name="OIO">
	<file>octopus-image-optimizer.php</file>
	<file>uninstall.php</file>
	<file>autoload.php</file>
	<file>core</file>
	<file>functions</file>
	<file>templates</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.DB.SlowDBQuery"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="octopus-image-optimizer"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DiscouragedFunctions"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="octopus"/>
				<element value="Octopus"/>
			</property>
		</properties>
	</rule>
</ruleset>
